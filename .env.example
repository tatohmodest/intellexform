# Copy to .env (or .env.local) and fill in values. Never commit real secrets.

# Supabase Postgres (Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""
SUPABASE_SECRET_KEY=""

# LoopingBinary OAuth 2.0
LB_OAUTH_CLIENT_ID=""
LB_OAUTH_CLIENT_SECRET=""
LB_OAUTH_AUTHORIZE_URL="https://auth.loopingbinary.com/api/oauth/authorize"
LB_OAUTH_TOKEN_URL="https://auth.loopingbinary.com/api/oauth/token"
LB_OAUTH_USERINFO_URL="https://auth.loopingbinary.com/api/oauth/userinfo"
LB_OAUTH_REDIRECT_URI="http://localhost:3000/oauth/callback"
SESSION_SECRET=""
# Long random string. Required for login cookies. If you rotate it, old browsers
# keep a stale cookie until the app expires it — keep this set in production.

# Google / GitHub OAuth (optional)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
GOOGLE_ID=""
GOOGLE_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# Agora (live mentorship / classes)
NEXT_PUBLIC_AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# AI Tutor + book tutor (OpenAI).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Media (Cloudinary) - required for mentor CVs, IDs, videos, and assignment file uploads.
# Dashboard → Settings → API Keys: copy Cloud name, API Key, API Secret.
# Settings → Security: allow resource types image, video, and raw (PDF/DOC/DOCX need raw).
# Keep uploads as type "upload" (public delivery). Do not force authenticated-only unless
# you only access files via our signed download/view API routes.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Payments (PayUnit / African gateways)
# Direct pay (in-app): initialize + makepayment sends an MTN/Orange USSD prompt.
# No hosted checkout redirect. PAYUNIT_APP_ID is an alias for PAYUNIT_API_USER.
# PAYUNIT_GATEWAY_URL is an alias for PAYUNIT_BASE_URL.
PAYUNIT_API_KEY=""
PAYUNIT_API_PASSWORD=""
PAYUNIT_API_USER=""
PAYUNIT_APP_ID=""
PAYUNIT_BASE_URL="https://gateway.payunit.net"
PAYUNIT_GATEWAY_URL="https://gateway.payunit.net"
PAYUNIT_MODE="test"
PAYUNIT_CALLBACK_URL=""
RETURN_URL="http://localhost:3000/payment/return"
WEBHOOK_URL="http://localhost:3000/api/payments/webhook"

# Email (SMTP). Same transport for signup, login OTP, password reset, and admin OTP.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
# Resend: SMTP_HOST=smtp.resend.com SMTP_PORT=465 SMTP_USER=resend SMTP_PASS=<API key>
# EMAIL_FROM must be a verified sender (Gmail: same as SMTP_USER).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=""
SMTP_SECURE=""
EMAIL_FROM=intellex@loopingbinary.com

# Admin allowlist (comma-separated). Defaults always include:
# modestwilton@gmail.com,tatohmodest@gmail.com
ADMIN_EMAILS="modestwilton@gmail.com,tatohmodest@gmail.com"

# Legacy Mongo (transition) - optional while migrating to Supabase
MONGODB_URL=""
ADMIN_SECRET=""

# Public site URL used for share links / Open Graph (never a Vercel *.vercel.app host)
APP_PUBLIC_URL="https://intellex.loopingbinary.com"
NEXT_PUBLIC_APP_URL="https://intellex.loopingbinary.com"

# Single-institution clone settings (this deployment IS the institution)
INSTITUTION_SLUG="intellex"
INSTITUTION_NAME="InTelleX"
INSTITUTION_TAGLINE="Learn. Connect. Grow."
INSTITUTION_COLOR="#00b369"
INSTITUTION_LOGO_URL=""
INSTITUTION_REQUIRE_APPLICATION_FEE="0"
INSTITUTION_APPLICATION_FEE_XAF="0"

# Web Push (PWA). Optional: if unset, InTelleX generates and stores VAPID keys in Mongo.
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:intellex@loopingbinary.com"

# YouTube Data API v3. Video Hall search calls GET https://www.googleapis.com/youtube/v3/search
# (search.list: part=snippet, type=video, videoEmbeddable=true). Create a key in Google Cloud
# with YouTube Data API v3 enabled. Search Queries quota is limited — results are cached.
YOUTUBE_API_KEY=""
