// InTelleX EduOS - federated education operating system
//
// Golden rule: Nothing important is created by accident, accessed without
// permission, or managed without accountability. Every institution, role,
// resource, and action has a clear owner, approval process, and audit trail.
//
// Architecture:
// - Layer 1 (Core): identity, institution registry, applications, API gateway
//   metadata, global search index - NOT academic records.
// - Layer 2 (Institution): each campus owns its academic data (shared SaaS
//   row isolation today; dedicated DB / customer-hosted / hybrid when provisioned).
//
// See docs/EDUOS_ARCHITECTURE.md and lib/eduos/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

/// Platform-wide authority (InTelleX Core). Exactly one PLATFORM_OWNER.
enum GlobalRole {
  USER
  SUPPORT
  PLATFORM_ADMIN
  PLATFORM_OWNER
}

/// Campus membership roles - least privilege. Hierarchy of authority lives
/// in lib/eduos/permissions.ts; this enum is the persisted label only.
enum MembershipRole {
  GUEST
  STUDENT
  TEACHING_ASSISTANT
  INSTRUCTOR
  MENTOR
  DEPARTMENT_ADMIN
  ORG_ADMIN
  INSTITUTION_OWNER
  STAFF
}

enum InstitutionVisibility {
  PUBLIC
  PRIVATE
}

enum CustomizationLevel {
  DEFAULT
  BRANDED
  ENTERPRISE
}

/// How the institution's Layer-2 infrastructure is hosted.
enum DeploymentModel {
  SHARED_SAAS
  MANAGED_CLOUD
  DEDICATED_DB
  CUSTOMER_HOSTED
  HYBRID
  EXTERNAL_SIS
}

/// PostgreSQL tenancy strategy for an organization (maps from DeploymentModel).
/// shared = Intellex-managed shared Postgres (default)
/// dedicated = Intellex-managed dedicated Postgres
/// customer_managed = enterprise BYO Postgres (admin-configured only)
enum DatabaseMode {
  SHARED
  DEDICATED
  CUSTOMER_MANAGED
}

/// Lifecycle of a catalog subscription / commercial plan row.
enum CatalogPlanKind {
  STUDENT_RESOURCE
  ORGANIZATION
}

enum CatalogPlanStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

/// Lifecycle of an institution in the network (never silently ACTIVE).
enum InstitutionLifecycleStatus {
  PENDING
  PROVISIONING
  ACTIVE
  SUSPENDED
  REJECTED
  ARCHIVED
}

enum EnrollmentPolicyType {
  PUBLIC_OPEN
  PUBLIC_REQUEST
  INVITE_ONLY
  DOMAIN_BASED
  CODE_BASED
  MIXED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  WITHDRAWN
}

enum InstitutionType {
  UNIVERSITY
  ACADEMY
  COMPANY
  NGO
  SCHOOL
  BOOTCAMP
  GOVERNMENT
  OTHER
}

enum MentorTier {
  COMMUNITY
  PROFESSIONAL
  SENIOR
  INDUSTRY_EXPERT
}

enum VerificationRequestStatus {
  PENDING
  VERIFIED
  NOT_FOUND
  ACCESS_DENIED
  CONSENT_REQUIRED
  UNDER_REVIEW
}

enum SensitiveActionKind {
  DELETE_COURSE
  REMOVE_INSTRUCTOR
  TRANSFER_OWNERSHIP
  DELETE_DEPARTMENT
  CHANGE_BILLING
  SUSPEND_INSTITUTION
  PROVISION_INSTITUTION
  ISSUE_API_CREDENTIALS
}

enum CourseStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum CoursePricingType {
  FREE
  ONE_TIME
  SUBSCRIPTION
  BUNDLE
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LessonContentType {
  VIDEO
  MARKDOWN
  RICH_TEXT
  CODE
  AUDIO
  DOWNLOAD
  QUIZ
  ASSIGNMENT
  LIVE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MULTIPLE_SELECT
  ESSAY
  FILL_BLANK
  CODE
  DRAG_DROP
  MATCH
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  GRADED
  RETURNED
  LATE
}

enum MentorshipStatus {
  REQUESTED
  ACCEPTED
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LiveProvider {
  ZOOM
  GOOGLE_MEET
  JITSI
  WEBRTC
  AGORA
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
  STUDY_GROUP
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum WalletTxnType {
  CREDIT
  DEBIT
  REFUND
  REWARD
  AFFILIATE
  SCHOLARSHIP
  PURCHASE
  WITHDRAWAL
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  FLUTTERWAVE
  PAYSTACK
  ORANGE_MONEY
  MTN_MOMO
  STRIPE
  PAYPAL
  BANK_TRANSFER
  PAYUNIT
  WALLET
