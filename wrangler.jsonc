{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intellexform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Lesson bodies (/_tc) are read by the app through ASSETS; public requests go to the
    // app instead, where middleware.ts returns 404.
    "run_worker_first": ["/_tc/*"]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "intellexform"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Cloudflare's build step already runs `next build`; this bundles it for Workers and
  // ships the lesson bodies as private assets.
  "build": {
    "command": "npx opennextjs-cloudflare build --skipNextBuild && cp -R .tutorial-content .open-next/assets/_tc"
  }
}
